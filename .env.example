# Copy this file to .env and fill in the values: cp .env.example .env

# Required. Base64-encoded key of at least 256 bits. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Default admin account, created on first startup if the database has no admin yet.
# Change the password before using this anywhere other than your own machine.
ADMIN_EMAIL=admin@wasabi.local
ADMIN_PASSWORD=admin123

# Fill an empty database with a demo menu, banners, discounts, orders and a demo customer
# (customer@wasabi.local / customer123). Leave this off outside local development.
SEED_DEMO_DATA=true

# Optional: image uploads (menu items, banners, discounts) need a Cloudinary account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: path to a Firebase service-account JSON. Push notifications are disabled without it.
# FIREBASE_CREDENTIALS_PATH=src/main/resources/firebase-service-account/sushi-wasabi-service-account.json

# Optional: database overrides. Defaults match docker-compose.yml.
# DB_URL=jdbc:postgresql://localhost:5431/wasabi
# DB_USERNAME=postgres
# DB_PASSWORD=root
